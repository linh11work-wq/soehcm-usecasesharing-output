<div id="lb" hidden><button class="x" type="button">Đóng</button><img alt=""></div>
<script>
(function(){
  var tabs=[].slice.call(document.querySelectorAll('.tab'));
  var ids=['tong-quan','session'];
  function show(id){
    if(ids.indexOf(id)<0) id='tong-quan';
    tabs.forEach(function(t){var on=t.getAttribute('aria-controls')===id;t.setAttribute('aria-selected',on);t.tabIndex=on?0:-1;});
    ids.forEach(function(p){document.getElementById(p).hidden=(p!==id);});
  }
  tabs.forEach(function(t,i){
    t.addEventListener('click',function(){var id=t.getAttribute('aria-controls');show(id);try{history.replaceState(null,'','#'+id)}catch(e){}window.scrollTo({top:0});});
    t.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key==='ArrowLeft'){var n=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];n.focus();n.click();}});
  });
  show((location.hash||'').slice(1));
  var lbox=document.getElementById('lb'),lbi=lbox.querySelector('img');
  document.addEventListener('click',function(e){var b=e.target.closest('[data-full]');if(b){lbi.src=b.getAttribute('data-full');lbox.hidden=false;return;}if(!lbox.hidden&&e.target.closest('#lb')){lbox.hidden=true;}});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')lbox.hidden=true;});

  var c=document.getElementById('net');if(!c||matchMedia('(prefers-reduced-motion: reduce)').matches)return;
  var x=c.getContext('2d'),pts=[],W,H;
  function size(){W=c.width=innerWidth;H=c.height=innerHeight;pts=[];var n=Math.min(70,Math.floor(W*H/22000));for(var i=0;i<n;i++)pts.push({x:Math.random()*W,y:Math.random()*H,vx:(Math.random()-.5)*.25,vy:(Math.random()-.5)*.25});}
  function draw(){x.clearRect(0,0,W,H);for(var i=0;i<pts.length;i++){var p=pts[i];p.x+=p.vx;p.y+=p.vy;if(p.x<0||p.x>W)p.vx*=-1;if(p.y<0||p.y>H)p.vy*=-1;
    x.fillStyle='rgba(124,255,160,.55)';x.beginPath();x.arc(p.x,p.y,1.4,0,6.3);x.fill();
    for(var j=i+1;j<pts.length;j++){var q=pts[j],d=Math.hypot(p.x-q.x,p.y-q.y);if(d<130){x.strokeStyle='rgba(124,255,160,'+(.12*(1-d/130))+')';x.beginPath();x.moveTo(p.x,p.y);x.lineTo(q.x,q.y);x.stroke();}}}
    requestAnimationFrame(draw);}
  size();addEventListener('resize',size);draw();
})();
</script>
