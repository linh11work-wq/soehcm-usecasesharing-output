table{width:100%;border-collapse:collapse;min-width:720px;font-variant-numeric:tabular-nums}
th,td{text-align:left;padding:12px 14px;vertical-align:top;border-top:1px solid var(--line)}
thead th{border-top:0;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--mint);font-weight:700}
td.num,th.num{text-align:right}
tbody td:first-child{font-weight:700}
tfoot td{font-weight:700;color:var(--mint);border-top:1px solid rgba(124,255,160,.35)}

/* session detail */
.sess-head{display:flex;flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:6px}
.sess-head h2{margin:0}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin:6px 0 18px}
.chip{font-size:12.5px;font-weight:600;padding:5px 11px;border-radius:999px;background:rgba(124,255,160,.10);color:var(--mint)}
.chip.plain{background:rgba(238,246,240,.07);color:var(--fg-2)}
.cols2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:28px}
@media (max-width:800px){.cols2{grid-template-columns:1fr}}
.fb-h{margin-top:22px!important}
.cols2 > div{min-width:0}
.takeaway{margin-top:18px;padding:14px 16px;border-radius:12px;background:rgba(124,255,160,.08);font-weight:600}
.takeaway small{display:block;font-weight:600;font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mint);margin-bottom:4px}

/* impact */
.impact-top{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:18px}
.impact-top .stat{flex:1 1 140px}
.shots{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
@media (max-width:640px){.shots{grid-template-columns:1fr}}
.shots{grid-template-columns:repeat(auto-fill,minmax(200px,1fr))}
figure.shot{margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
.shot button{all:unset;cursor:zoom-in;display:block;border-radius:12px;overflow:hidden;background:rgba(5,19,15,.45);aspect-ratio:3/4;max-width:100%}
.shot button:focus-visible{outline:2px solid var(--mint);outline-offset:2px}
.shot img{width:100%;height:100%;object-fit:cover;object-position:top;display:block;transition:transform .25s}
.shot button:hover img{transform:scale(1.03)}
.shot figcaption{font-size:13px;color:var(--fg-2);line-height:1.5}
.shot figcaption b{color:var(--fg);font-weight:600}
.apply{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
@media (max-width:900px){.apply{grid-template-columns:1fr}}
.apply .shot button{aspect-ratio:4/5}
.apply .tag{font-size:11.5px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mint)}
#lb{position:fixed;inset:0;z-index:50;background:rgba(3,10,8,.92);display:grid;place-items:center;padding:24px;cursor:zoom-out}
#lb img{max-width:min(100%,900px);max-height:calc(100vh - 48px);border-radius:12px;box-shadow:0 20px 60px rgba(0,0,0,.5)}
#lb .x{position:absolute;top:calc(12px + env(safe-area-inset-top,0px));right:16px;font:inherit;font-weight:700;color:var(--fg);background:rgba(238,246,240,.1);border:0;border-radius:10px;padding:8px 14px;cursor:pointer}
.btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:14px;text-decoration:none;color:#0D2A21;background:var(--mint);
  padding:11px 18px;border-radius:10px}
.btn:hover{background:var(--fg)}
.btn svg{width:16px;height:16px}
.row-end{display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;margin-top:18px}
.chain{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);gap:14px;align-items:center}
.chain .arrow{color:var(--mint);font-size:22px;font-weight:700}
@media (max-width:640px){.chain{grid-template-columns:1fr}.chain .arrow{transform:rotate(90deg);justify-self:center}}
.note{font-size:12.5px;color:var(--fg-3);margin-top:14px}
@media (prefers-reduced-motion:reduce){#net{display:none}}
</style>

