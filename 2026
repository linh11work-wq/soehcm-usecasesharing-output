/* Layout: sticky tab bar over a single 1100px column; each tab is a stack of dark glass panels on a deep green network ground */
:root{
  --bg-0:#05130F; --bg-1:#0D2A21;
  --panel:rgba(20,54,43,.55); --panel-strong:rgba(26,68,54,.75);
  --line:rgba(124,255,160,.14);
  --mint:#7CFFA0; --mint-dim:#4FD67D;
  --fg:#EEF6F0; --fg-2:#A9C2B5; --fg-3:#7C9A8B;
  --font:"Google Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{background:var(--bg-0)}
body{margin:0;font-family:var(--font);color:var(--fg);font-size:15px;line-height:1.65;
  background:radial-gradient(1200px 600px at 85% -10%,rgba(124,255,160,.10),transparent 60%),
             linear-gradient(180deg,var(--bg-0),var(--bg-1) 70%,var(--bg-0));
  background-color:var(--bg-0);min-height:100vh}
#net{position:fixed;inset:0;width:100%;height:100%;pointer-events:none;opacity:.5;z-index:0}
.wrap{position:relative;z-index:1;max-width:1100px;margin:0 auto;padding-inline:20px;padding-block:28px 64px}
header.top{display:flex;flex-direction:column;gap:6px;padding-block:8px 20px}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--mint)}
h1{margin:0;font-size:clamp(28px,4.4vw,44px);line-height:1.12;font-weight:700;text-wrap:balance}
.sub{color:var(--fg-2);max-width:62ch;margin:4px 0 0}

nav.tabs{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;gap:6px;overflow-x:auto;
  padding:10px;margin-bottom:28px;background:rgba(5,19,15,.82);backdrop-filter:blur(10px);
  border-radius:14px;scrollbar-width:none}
nav.tabs::-webkit-scrollbar{display:none}
.tab{flex:0 0 auto;font:inherit;font-size:14px;font-weight:600;color:var(--fg-2);background:transparent;border:0;
  padding:10px 16px;border-radius:10px;cursor:pointer;white-space:nowrap}
.tab .n{display:inline-grid;place-items:center;width:22px;height:22px;margin-right:8px;border-radius:6px;
  background:rgba(238,246,240,.08);color:var(--fg-2);font-size:12px}
.tab:hover{color:var(--fg)}
.tab[aria-selected="true"]{background:var(--panel-strong);color:var(--fg)}
.tab[aria-selected="true"] .n{background:var(--fg);color:#0D2A21}
.tab:focus-visible,.btn:focus-visible{outline:2px solid var(--mint);outline-offset:2px}

section.pane{display:flex;flex-direction:column;gap:20px}
.panel{background:linear-gradient(160deg,var(--panel-strong),var(--panel));border-radius:18px;padding:26px;
  box-shadow:0 10px 30px rgba(0,0,0,.25);min-width:0}
.panel h2{margin:0 0 14px;font-size:20px;font-weight:700;display:flex;align-items:center;gap:12px;text-wrap:balance}
.panel h3{margin:0 0 8px;font-size:13px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--mint)}
.badge{display:inline-grid;place-items:center;min-width:34px;height:34px;padding:0 8px;border-radius:9px;background:var(--fg);
  color:#0D2A21;font-weight:700;font-size:14px}
p{margin:0 0 10px}
p:last-child{margin-bottom:0}
.muted{color:var(--fg-2)}
.small{font-size:13px;color:var(--fg-3)}
ul.clean{margin:0;padding-left:18px;display:flex;flex-direction:column;gap:6px}
ul.clean li::marker{color:var(--mint)}
.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px}
.grid3{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width:760px){.grid2,.grid3{grid-template-columns:1fr}.panel{padding:20px}}

/* quotes */
.quote{margin:0;padding:14px 16px;border-radius:12px;background:rgba(5,19,15,.45);font-size:15px}
.quote p{margin:0 0 6px;font-weight:500}
.quote cite{font-style:normal;font-size:12.5px;color:var(--fg-3)}
.quotes{display:flex;flex-direction:column;gap:10px}

/* definition rows */
.defs{display:grid;grid-template-columns:170px minmax(0,1fr);gap:0}
.defs dt,.defs dd{padding:14px 0;border-top:1px solid var(--line);margin:0}
.defs dt{font-weight:700;color:var(--mint);font-size:13px;letter-spacing:.08em;text-transform:uppercase;padding-right:16px}
.defs dt:first-of-type,.defs dt:first-of-type + dd{border-top:0}
@media (max-width:640px){.defs{grid-template-columns:1fr}.defs dt{padding-bottom:2px}.defs dd{border-top:0;padding-top:0}}

/* stats */
.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:12px}
